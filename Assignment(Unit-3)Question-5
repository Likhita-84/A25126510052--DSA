/*5 A department maintains student roll numbers dynamically. Write a C program using a Singly
Linked List to create the list, insert at the beginning and end, search for a specified roll number,
delete a specified roll number, and display the updated list after each operation. Handle the case
when a requested roll number is not available.*/

/* C program to handle roll numbers using linked lists.*/
#include <stdio.h>
#include <stdlib.h>
/*Create a struct called node*/
struct Node{
    int rollno;
    struct Node* next;
};
/*Create pointer called head and initiaze it to null*/
struct Node*head=NULL;

struct Node* createNode(int rollno){
    /*Allocate the memory dynamically*/
    struct Node* newnode=malloc(sizeof(struct Node));
    if(newnode==NULL){
        printf("Memory allocation failed!\n");
        exit(1);
    }
    newnode->rollno=rollno;
    newnode->next=NULL;
    return newnode;
}

/*Fuction to insert rollno at beginning of the list*/
void insertAtBeginning(int rollno){
    struct Node* newnode=createNode(rollno);
    newnode->next=head;
    head=newnode;
}

/*Fuction to insert rollno at end of the list*/
void insertAtend(int rollno){
    struct Node* newnode=createNode(rollno);
    if(head==NULL){
        head=newnode;
    }
    else{
        struct Node* temp=head;
        while(temp->next!=NULL){
            temp=temp->next;
        }
        temp->next=newnode;
    }
}

/*Function to search for a rollno*/
/* Here key is the rollno to be searched.*/
void search(int key){
    struct Node* temp=head;
    int pos=1;
    while(temp!=NULL){
        if(temp->rollno==key){
            printf("Roll number %d is found at position %d \n",key,pos);
            return;
        }
        temp=temp->next;
        pos++;
    }
    printf("Roll number %d not found in the list\n",key);
}
/* Function to delete a given roll number.*/
void delete(int value){
    struct Node*temp=head;
    struct Node*prev=NULL;
    /* Creating a while loop to search for the element*/
    while (temp!=NULL&&temp->rollno!=value) {
        prev=temp;
        temp=temp->next;
    }
    if(temp==NULL){
        printf("Roll number %d not found.\n",value);
        return;
    }
    if(prev==NULL)  
        head=temp->next;
    else
        prev->next=temp->next;
    free(temp);
    printf("%d roll number deleted from the list.\n",value);          
}
/*Function to display the linked list*/
void display(){
    struct Node*temp=head;
    if (temp==NULL) {
        printf("The student list is empty.\n");
        return;
    }
    printf("Current Student Roll Numbers: ");
    while(temp != NULL) {
        printf("%d -> ",temp->rollno);
        temp=temp->next;
    }
    printf("NULL\n");
}
int main()
{
    /*Create choice and value integer variables*/
    int choice, value;
    /*Create a while loop which executes until the condition is true*/
    while(1) {
        printf("\n====== Student Roll Number System =====\n");
        printf("1. Insert Beginning\n");
        printf("2. Insert End\n");
        printf("3. Search Roll Number\n");
        printf("4. Delete Roll Number\n");
        printf("5. Display List\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        /*Create switch case to handle different cases*/
         switch(choice) {
            case 1:
                printf("Enter roll number to insert: ");
                scanf("%d",&value);
                insertAtBeginning(value);
                display();
                break;
            case 2:
                printf("Enter roll number to insert: ");
                scanf("%d", &value);
                insertAtend(value);
                display();
                break;
                case 3:
                printf("Enter roll number to search: ");
                scanf("%d", &value);
                search(value);
                break;
            case 4:
                printf("Enter roll number to delete: ");
                scanf("%d", &value);
                delete(value);
                display();
                break;
            case 5:
                display();
                break;
            case 6:
                printf("Exiting system.\n");
                printf("Thank you!");
                return 0;
            default:
                printf("Invalid selection! Please try again.\n");
        }
    }
}
